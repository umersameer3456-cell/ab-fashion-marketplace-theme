{% doc %}
  @prompt
    <|sidekick_start|> TASK: Collection list hover slide animation block بنائیں shopify navigate: "themes/158371381386/editor?generate=block&target=newBlocksSection&prompt=Create%20a%20collection%20list%20section%20where%20each%20collection%20card%20has%20a%20smooth%20hover%20slide%2Fzoom%20animation%20effect%20%E2%80%94%20similar%20to%20product%20card%20image%20hover%20effects.%20When%20the%20user%20hovers%20over%20a%20collection%20card%2C%20the%20image%20should%20smoothly%20slide%20or%20scale%20up%2C%20and%20the%20card%20should%20have%20a%20subtle%20overlay%20with%20the%20collection%20title.%20The%20section%20should%20display%20collections%20in%20a%20responsive%20grid%20layout." <|sidekick_end|>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-list-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-list-{{ ai_gen_id }}__inner {
    width: 100%;
  }

  .ai-collection-list-{{ ai_gen_id }}__heading {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.heading_alignment }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-collection-list-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-list-{{ ai_gen_id }}__card {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background-color: {{ block.settings.card_background }};
    color: {{ block.settings.text_color }};
    text-decoration: none;
    aspect-ratio: 1 / 1.12;
  }

  .ai-collection-list-{{ ai_gen_id }}__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: {{ block.settings.placeholder_background }};
  }

  .ai-collection-list-{{ ai_gen_id }}__media img,
  .ai-collection-list-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .ai-collection-list-{{ ai_gen_id }}__media svg {
    color: {{ block.settings.muted_color }};
  }

  .ai-collection-list-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 20px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 35%, {{ block.settings.overlay_color }} 100%);
    transition: background-color 300ms ease;
  }

  .ai-collection-list-{{ ai_gen_id }}__title {
    position: relative;
    z-index: 1;
    margin: 0;
    color: {{ block.settings.overlay_text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    line-height: 1.25;
  }

  .ai-collection-list-{{ ai_gen_id }}__card:hover .ai-collection-list-{{ ai_gen_id }}__media img,
  .ai-collection-list-{{ ai_gen_id }}__card:focus-visible .ai-collection-list-{{ ai_gen_id }}__media img {
    transform: scale({{ block.settings.hover_scale }});
  }

  .ai-collection-list-{{ ai_gen_id }}__card:hover .ai-collection-list-{{ ai_gen_id }}__overlay,
  .ai-collection-list-{{ ai_gen_id }}__card:focus-visible .ai-collection-list-{{ ai_gen_id }}__overlay {
    background-color: rgba(0, 0, 0, 0.12);
  }

  .ai-collection-list-{{ ai_gen_id }}__card:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-collection-list-{{ ai_gen_id }}__empty {
    padding: 32px 20px;
    border: 1px dashed {{ block.settings.muted_color }};
    color: {{ block.settings.muted_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-list-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
    }

    .ai-collection-list-{{ ai_gen_id }}__overlay {
      padding: 14px;
    }

    .ai-collection-list-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-list-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collection-list-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if block.settings.collections != blank %}
      <div class="ai-collection-list-{{ ai_gen_id }}__grid">
        {% for collection in block.settings.collections %}
          <a class="ai-collection-list-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="View {{ collection.title | escape }} collection">
            <div class="ai-collection-list-{{ ai_gen_id }}__media">
              {% if collection.featured_image %}
                <img src="{{ collection.featured_image | image_url: width: 1200 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">
              {% elsif collection.image %}
                <img src="{{ collection.image | image_url: width: 1200 }}" alt="{{ collection.image.alt | default: collection.title | escape }}" loading="lazy" width="{{ collection.image.width }}" height="{{ collection.image.height }}">
              {% else %}
                <div class="ai-collection-list-{{ ai_gen_id }}__media">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-collection-list-{{ ai_gen_id }}__overlay">
              <h3 class="ai-collection-list-{{ ai_gen_id }}__title">{{ collection.title | escape }}</h3>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-collection-list-{{ ai_gen_id }}__empty">Select collections to display them here.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection hover grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
