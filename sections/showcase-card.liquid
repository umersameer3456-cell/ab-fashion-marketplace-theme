{% assign selected_collection = collections[section.settings.collection] %}
<section class="section">
  <div class="container">
    <div class="collection-promo" {% if section.settings.image != blank %}style="background-image:url('{{ section.settings.image | image_url: width: 1200 }}')"{% endif %}>
      <h3>{{ section.settings.title }}</h3>
      {% if section.settings.button_label != blank %}
        <a class="button" href="{{ selected_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Collection banner","settings":[{"type":"text","id":"title","label":"Title","default":"New arrivals"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"}],"presets":[{"name":"Collection banner","category":"Homepage"}]}
{% endschema %}
