<section class="hero hero-slider" data-slider data-autoplay="{{ section.settings.autoplay }}">
  {% for block in section.blocks %}
    <article class="hero-slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
      <div class="hero-slide__media">{% if block.settings.image != blank %}<picture>{% if block.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', alt: block.settings.heading }}</picture>{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div>
      <div class="container hero-slide__content hero-slide__content--{{ block.settings.position }}"><span class="hero__eyebrow">{{ block.settings.eyebrow }}</span><h1>{{ block.settings.heading }}</h1><p>{{ block.settings.subheading }}</p>{% if block.settings.offer != blank %}<strong class="hero-slide__offer">{{ block.settings.offer }}</strong>{% endif %}<a class="button" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a></div>
    </article>
  {% endfor %}
  {% if section.blocks.size > 1 %}<button class="slider-arrow slider-arrow--prev" type="button" data-slide-prev aria-label="Previous slide">‹</button><button class="slider-arrow slider-arrow--next" type="button" data-slide-next aria-label="Next slide">›</button><div class="slider-dots">{% for block in section.blocks %}<button type="button" data-slide-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>{% endfor %}</div>{% endif %}
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [{ "type": "checkbox", "id": "autoplay", "label": "Autoplay slides", "default": true }],
  "blocks": [{ "type": "slide", "name": "Slide", "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "AB FASHION EDIT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Define your style" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover premium fashion, fragrances and accessories." },
    { "type": "text", "id": "offer", "label": "Offer text", "default": "Starting from $49" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "position", "label": "Text position", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default":"left" }
  ] }],
  "max_blocks": 6,
  "presets": [{ "name": "Hero banner", "category": "Homepage" }]
}
{% endschema %}
