<section class="section hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      {% if section.settings.eyebrow != blank %}
        <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
      <div class="hero__actions">
        {% if section.settings.cta_label != blank and section.settings.cta_url != blank %}
          <a class="button" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_url != blank %}
          <a class="button button--secondary" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
    <div class="hero__visual">
      {% assign hero_image = section.settings.image %}
      {% if section.settings.mobile_image != blank and request.design_mode == false %}
        <picture><source media="(max-width: 600px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{{ hero_image | image_url: width: 1400 | image_tag: alt: section.settings.heading, loading: 'eager' }}</picture>
      {% elsif hero_image != blank %}
        {{ hero_image | image_url: width: 1400 | image_tag: alt: section.settings.heading, loading: 'eager' }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated luxury" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Luxury for every moment." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Curated designer essentials in fashion, fragrance, watches, and accessories for a refined everyday wardrobe." },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "New arrivals" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
    ,{ "type": "image_picker", "id": "mobile_image", "label": "Mobile image" }
  ],
  "presets": [{ "name": "Hero banner", "category": "Homepage" }]
}
{% endschema %}
