<section class="section">
  <div class="container">
    <div class="newsletter">
      <div class="newsletter__inner">
        <div>
          <h3>{{ section.settings.title }}</h3>
          {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
        </div>
        <form method="post" action="/contact#newsletter" class="newsletter__form">
          <input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address">
          <button class="button button--accent" type="submit">{{ section.settings.button_label }}</button>
        </form>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Stay in style" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Subscribe for first access to new collections, exclusive sales, and style inspiration." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join now" }
  ],
  "presets": [{ "name": "Newsletter", "category": "Homepage" }]
}
{% endschema %}
