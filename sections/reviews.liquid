<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>{{ section.settings.title }}</h2>
    </div>
    <div class="grid-3">
      <div class="content-card">
        <div class="product-card__rating">★★★★★</div>
        <p>“The quality is exceptional and the packaging felt truly premium. I’ll definitely order again.”</p>
        <strong>Amelia R.</strong>
      </div>
      <div class="content-card">
        <div class="product-card__rating">★★★★★</div>
        <p>“I love the elegance of the watch and the overall shopping experience. The site feels luxurious.”</p>
        <strong>David L.</strong>
      </div>
      <div class="content-card">
        <div class="product-card__rating">★★★★★</div>
        <p>“Everything arrived quickly and looked even better than the photos. A beautiful brand.”</p>
        <strong>Rina S.</strong>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Customer reviews" }
  ],
  "presets": [{ "name": "Customer reviews", "category": "Homepage" }]
}
{% endschema %}
