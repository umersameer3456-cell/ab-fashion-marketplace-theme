<section class="section"><div class="container"><div class="promo-cards">{% for block in section.blocks %}{% assign promo_link = block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url %}<a class="promo-card" href="{{ promo_link }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.heading }}{% endif %}<span class="promo-card__copy"><strong>{{ block.settings.kicker }}</strong><h2>{{ block.settings.heading }}</h2><p>{{ block.settings.text }}</p><span class="button button--small">{{ block.settings.button_label }}</span></span></a>{% endfor %}</div></div></section>
{% schema %}
{"name":"Promotional cards","settings":[],"blocks":[{"type":"card","name":"Promo card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"kicker","label":"Kicker","default":"NEW COLLECTION"},{"type":"text","id":"heading","label":"Heading","default":"Discover your style"},{"type":"textarea","id":"text","label":"Text","default":"Fresh styles for every occasion"},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"link","label":"Fallback link"}]}],"max_blocks":3,"presets":[{"name":"Three promotional cards"}]}
{% endschema %}
