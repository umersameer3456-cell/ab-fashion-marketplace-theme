<section class="section collection-header">
  <div class="container">
    <div class="collection-banner">
      <p style="text-transform:uppercase; letter-spacing:0.1em; color: var(--color-muted); margin:0 0 8px;">Collection</p>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="collection-layout">
      <aside class="filters">
        {% if collection.filters != blank %}
          {% for filter in collection.filters %}
            <div class="filter-group">
              <h4>{{ filter.label }}</h4>
              {% for filter_value in filter.values %}
                {% if filter_value.count > 0 %}
                  <a href="{{ filter_value.url }}">{{ filter_value.label }} ({{ filter_value.count }})</a>
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        {% else %}
          <div class="filter-group">
            <h4>Collection</h4>
            <a href="{{ collection.url }}">All products</a>
          </div>
        {% endif %}
      </aside>

      <div>
        <div class="collection-toolbar">
          <p>{{ collection.products_count }} products</p>
          <form class="sort-select" method="get" action="{{ collection.url }}">
            <label for="SortBy" style="display:block; margin-bottom:8px;">{{ 'products.sort_by' | t }}</label>
            <select id="SortBy" name="sort_by" onchange="this.form.submit()">
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
              {% endfor %}
            </select>
          </form>
        </div>

        {% paginate collection.products by 24 %}
        {% if collection.products.size > 0 %}
          <div class="product-grid">
            {% for product in collection.products %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>
          {% render 'pagination', paginate: paginate %}
        {% else %}
          <div class="content-card">
            <p>No products match your selection.</p>
          </div>
        {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main collection",
  "settings": [],
  "presets": [{ "name": "Main collection", "category": "Collection" }]
}
{% endschema %}
