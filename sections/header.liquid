<header class="site-header" data-header>
  <div class="utility-bar"><div class="container utility-bar__inner"><span>{{ section.settings.utility_message }}</span><nav aria-label="Utility"><a href="{{ section.settings.track_link | default: routes.account_url }}">Track Order</a><a href="{{ section.settings.help_link | default: routes.root_url }}">Help</a><a href="{{ routes.account_login_url }}">Account</a></nav></div></div>
  <div class="container header-inner">
    <button class="icon-button mobile-menu" type="button" data-menu-toggle aria-label="Open menu">
      {% render 'icon-menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }}">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 220 | image_tag: alt: shop.name, width: 110 }}
      {% else %}
        <span class="brand__mark">AF</span><span>AB FASHION</span>
      {% endif %}
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {% if linklists[section.settings.menu].links == blank %}
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a>
        <a href="{{ routes.collections_url }}/best-sellers">Best Sellers</a>
        <a href="/pages/about-us">About</a>
        <a href="/pages/contact">Contact</a>
      {% else %}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% endif %}
    </nav>

    <div class="header-tools">
      <button class="icon-button" type="button" data-search-toggle aria-label="Search">
        {% render 'icon-search' %}
      </button>
      {% if shop.customer_accounts_enabled %}<a class="icon-button" href="{{ routes.account_url }}" aria-label="Account">
        {% render 'icon-user' %}
      </a>{% endif %}
      <a class="icon-button header-cart" href="{{ routes.cart_url }}" aria-label="Cart">
        {% render 'icon-cart' %}
        <span class="header-cart__count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <div class="search-bar-wrap"><div class="container"><form action="{{ routes.search_url }}" method="get" role="search" class="search-bar"><label class="visually-hidden" for="HeaderSearch">Search products</label><select name="type" aria-label="Search category"><option value="product">All Categories</option><option value="product">Products</option><option value="article">Articles</option></select><input id="HeaderSearch" type="search" name="q" placeholder="Search products, brands and styles" autocomplete="off"><button type="submit">Search</button></form></div></div>
  <div class="accent-strip"><div class="container accent-strip__inner"><strong>Shop By Department</strong><nav aria-label="Department navigation">{% for link in linklists[section.settings.department_menu].links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav><span class="accent-strip__utilities"><a href="{{ routes.cart_url }}">Recently viewed</a><a href="{{ routes.cart_url }}">Order tracking</a></span></div></div>

  <div class="search-modal" data-search-modal aria-hidden="true">
    <div class="search-modal__panel">
      <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}">
        <button class="button" type="submit">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu" },
    { "type": "link_list", "id": "department_menu", "label": "Department menu" },
    { "type": "text", "id": "utility_message", "label": "Utility message", "default": "Welcome to AB FASHION — premium style, delivered." },
    { "type": "url", "id": "track_link", "label": "Track order link" },
    { "type": "url", "id": "help_link", "label": "Help link" }
  ],
  "presets": [{ "name": "Header", "category": "Header" }]
}
{% endschema %}
