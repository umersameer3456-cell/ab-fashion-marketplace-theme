<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle }}</p>{% endif %}
    </div>
    <div class="category-grid">
      {% for block in section.blocks %}
        {% assign category_collection = block.settings.collection %}
        {% if category_collection != blank %}
          <a class="category-card" href="{{ category_collection.url }}" {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% elsif category_collection.featured_image != blank %}
              {{ category_collection.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: category_collection.title }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="category-card__content">
            <h3>{{ block.settings.title | default: category_collection.title }}</h3>
            <span>Shop collection</span>
          </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Discover our curated essentials" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Category image" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Shop by category", "category": "Homepage" }]
}
{% endschema %}
