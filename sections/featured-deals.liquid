{% assign deal_collection = section.settings.collection | default: collections.all %}
<section class="section deals"><div class="container"><div class="section-heading section-heading--row"><div><span class="eyebrow">Limited time</span><h2>{{ section.settings.heading }}</h2></div><div class="countdown" data-countdown="{{ section.settings.end_date }}"><span>Ends in</span><b data-days>00</b><i>:</i><b data-hours>00</b><i>:</i><b data-minutes>00</b><i>:</i><b data-seconds>00</b></div></div>{% if deal_collection != blank %}<div class="product-grid product-grid--six">{% for product in deal_collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div>{% endif %}</div></section>
{% schema %}
{"name":"Today's featured deals","settings":[{"type":"text","id":"heading","label":"Heading","default":"Today's Featured Deals"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":6},{"type":"text","id":"end_date","label":"Countdown end (YYYY-MM-DDTHH:MM:SS)","default":"2026-12-31T23:59:59"}],"presets":[{"name":"Today's featured deals"}]}
{% endschema %}
