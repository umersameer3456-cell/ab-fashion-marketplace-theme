<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="brand" style="color:#fff;">
          <span class="brand__mark">AF</span>
          <span>AB FASHION</span>
        </a>
        <p style="margin-top:20px;">Luxury essentials for every day and every occasion, curated with elevated design and premium craftsmanship.</p>
      </div>
      <div>
        <h4>Quick Links</h4>
        <ul class="footer-link-list">
          {% if linklists[section.settings.menu].links != blank %}
            {% for link in linklists[section.settings.menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
            <li><a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a></li>
            <li><a href="{{ routes.collections_url }}/best-sellers">Best Sellers</a></li>
          {% endif %}
        </ul>
      </div>
      <div>
        <h4>Customer Service</h4>
        <ul class="footer-link-list">
          <li><a href="/pages/about-us">About</a></li>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/returns">Return policy</a></li>
        </ul>
      </div>
      <div>
        <h4>Shop Categories</h4>
        <ul class="footer-link-list">
          <li><a href="{{ routes.collections_url }}/perfumes">Perfumes</a></li>
          <li><a href="{{ routes.collections_url }}/watches">Watches</a></li>
          <li><a href="{{ routes.collections_url }}/clothes">Clothes</a></li>
          <li><a href="{{ routes.collections_url }}/bags">Bags</a></li>
          <li><a href="{{ routes.collections_url }}/shoes">Shoes</a></li>
          <li><a href="{{ routes.collections_url }}/accessories">Accessories</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} AB FASHION</span>
      <span>
        {% if shop.policies.privacy_policy %}<a href="{{ shop.policies.privacy_policy.url }}">Privacy</a> · {% endif %}
        {% if shop.policies.refund_policy %}<a href="{{ shop.policies.refund_policy.url }}">Returns</a> · {% endif %}
        <a href="{{ routes.root_url }}policies">Policies</a> · Powered by Shopify
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Footer menu" }
  ],
  "presets": [{ "name": "Footer", "category": "Footer" }]
}
{% endschema %}
