<section class="section"><div class="container"><div class="discount-banner" style="{% if section.settings.image != blank %}background-image:url('{{ section.settings.image | image_url: width: 1800 }}');{% endif %}"><div><span class="eyebrow">{{ section.settings.kicker }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a></div></div></div></section>
{% schema %}
{"name":"Large discount banner","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"kicker","label":"Kicker","default":"UP TO 30% OFF"},{"type":"text","id":"heading","label":"Heading","default":"Instant fashion discount"},{"type":"textarea","id":"text","label":"Text","default":"Refresh your wardrobe with premium styles."},{"type":"text","id":"button_label","label":"Button label","default":"Shop sale"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Large discount banner"}]}
{% endschema %}
