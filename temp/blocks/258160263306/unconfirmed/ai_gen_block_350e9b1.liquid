{% doc %}
  @prompt
    Create a product listing block for the home page that shows products from a selected collection in a grid. It should have editable settings in the theme editor for: collection picker, products to show, heading, subtitle, link label, desktop width (percentage), columns on desktop (2, 3 or 4), columns on mobile (1 or 2), card gap in pixels, card radius in pixels, heading size in pixels, and a Colors section with background, card background, text, muted text, accent, card border, badge background, and badge text color settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-listing-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 32px 20px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    box-sizing: border-box;
  }

  .ai-product-listing__inner-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-product-listing__header-{{ ai_gen_id }} {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .ai-product-listing__heading-wrap-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-product-listing__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    font-weight: 700;
  }

  .ai-product-listing__subtitle-{{ ai_gen_id }} {
    margin: 8px 0 0;
    color: {{ block.settings.muted_text_color }};
    line-height: 1.5;
  }

  .ai-product-listing__link-{{ ai_gen_id }} {
    flex: 0 0 auto;
    color: {{ block.settings.accent_color }};
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-product-listing__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-product-listing__card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    background: {{ block.settings.card_background_color }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-product-listing__image-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1.15;
    overflow: hidden;
    background: {{ block.settings.card_border_color }};
  }

  .ai-product-listing__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .ai-product-listing__card:hover .ai-product-listing__image-{{ ai_gen_id }} {
    transform: scale(1.03);
  }

  .ai-product-listing__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.muted_text_color }};
  }

  .ai-product-listing__placeholder-{{ ai_gen_id }} svg {
    width: 65%;
    height: 65%;
  }

  .ai-product-listing__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 9px;
    border-radius: 3px;
    background: {{ block.settings.badge_background_color }};
    color: {{ block.settings.badge_text_color }};
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }

  .ai-product-listing__details-{{ ai_gen_id }} {
    padding: 16px;
  }

  .ai-product-listing__product-title-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
  }

  .ai-product-listing__price-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-weight: 700;
  }

  .ai-product-listing__compare-price-{{ ai_gen_id }} {
    margin-left: 6px;
    color: {{ block.settings.muted_text_color }};
    font-size: 13px;
    font-weight: 400;
    text-decoration: line-through;
  }

  .ai-product-listing__empty-{{ ai_gen_id }} {
    padding: 40px 20px;
    border: 1px dashed {{ block.settings.card_border_color }};
    color: {{ block.settings.muted_text_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-product-listing-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-product-listing__header-{{ ai_gen_id }} {
      align-items: start;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }

    .ai-product-listing__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
    }

    .ai-product-listing__details-{{ ai_gen_id }} {
      padding: 12px;
    }
  }
{% endstyle %}

<div class="ai-product-listing-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-listing__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subtitle != blank or block.settings.link_label != blank %}
      <div class="ai-product-listing__header-{{ ai_gen_id }}">
        <div class="ai-product-listing__heading-wrap-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-product-listing__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
          {% endif %}
          {% if block.settings.subtitle != blank %}
            <p class="ai-product-listing__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle | escape }}</p>
          {% endif %}
        </div>
        {% if block.settings.link_label != blank and block.settings.collection != blank %}
          <a class="ai-product-listing__link-{{ ai_gen_id }}" href="{{ block.settings.collection.url }}">{{ block.settings.link_label | escape }}</a>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
      <div class="ai-product-listing__grid-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <article class="ai-product-listing__card-{{ ai_gen_id }}">
            <a class="ai-product-listing__image-link-{{ ai_gen_id }}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image %}
                <img class="ai-product-listing__image-{{ ai_gen_id }}" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="920">
              {% else %}
                <div class="ai-product-listing__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
              {% if product.compare_at_price > product.price %}
                <span class="ai-product-listing__badge-{{ ai_gen_id }}">Sale</span>
              {% endif %}
            </a>
            <div class="ai-product-listing__details-{{ ai_gen_id }}">
              <a class="ai-product-listing__product-title-{{ ai_gen_id }}" href="{{ product.url }}">{{ product.title | escape }}</a>
              <div class="ai-product-listing__price-{{ ai_gen_id }}">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="ai-product-listing__compare-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-product-listing__empty-{{ ai_gen_id }}">Select a collection with products to display this listing.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product listing",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore our latest styles"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#191919"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#5f6368"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#1f6f2a"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Product listing"
    }
  ],
  "tag": null,
  "class": "product-listing-block"
}
{% endschema %}