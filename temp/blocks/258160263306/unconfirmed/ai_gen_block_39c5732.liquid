{% doc %}
  @prompt
    Create a product listing block for the home page that shows products from a selected collection in a grid. It should have editable settings in the theme editor for: desktop width (percentage), columns on desktop (2, 3 or 4), columns on mobile (1 or 2), card gap in pixels, card radius in pixels, heading size in pixels, plus a heading, subtitle, products to show, and a link label.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-listing-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: #191919;
  }

  .ai-product-listing__header-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .ai-product-listing__heading-{{ ai_gen_id }} {
    margin: 0;
    color: #191919;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    font-weight: 600;
  }

  .ai-product-listing__subtitle-{{ ai_gen_id }} {
    margin: 8px 0 0;
    color: #555555;
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-product-listing__link-{{ ai_gen_id }} {
    flex: 0 0 auto;
    color: #1a1a1a;
    font-size: 14px;
    line-height: 1.4;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-product-listing__link-{{ ai_gen_id }}:focus-visible,
  .ai-product-listing__card-link-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #35a93b;
    outline-offset: 3px;
  }

  .ai-product-listing__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-product-listing__card-{{ ai_gen_id }} {
    min-width: 0;
    overflow: hidden;
    border-radius: {{ block.settings.card_radius }}px;
    background: #ffffff;
  }

  .ai-product-listing__card-link-{{ ai_gen_id }} {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-product-listing__image-wrap-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f4f4f4;
  }

  .ai-product-listing__image-wrap-{{ ai_gen_id }} img,
  .ai-product-listing__image-wrap-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-listing__info-{{ ai_gen_id }} {
    padding: 14px 2px 2px;
  }

  .ai-product-listing__product-title-{{ ai_gen_id }} {
    margin: 0 0 6px;
    color: #191919;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 500;
  }

  .ai-product-listing__price-{{ ai_gen_id }} {
    color: #555555;
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-product-listing__empty-{{ ai_gen_id }} {
    padding: 36px 20px;
    border: 1px dashed #b8b8b8;
    border-radius: {{ block.settings.card_radius }}px;
    color: #555555;
    text-align: center;
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-product-listing-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-product-listing__header-{{ ai_gen_id }} {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }

    .ai-product-listing__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
{% endstyle %}

<div class="ai-product-listing-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.subtitle != blank or block.settings.link_label != blank %}
    <div class="ai-product-listing__header-{{ ai_gen_id }}">
      <div>
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-listing__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-product-listing__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle | escape }}</p>
        {% endif %}
      </div>
      {% if block.settings.link_label != blank and block.settings.collection != blank %}
        <a class="ai-product-listing__link-{{ ai_gen_id }}" href="{{ block.settings.collection.url }}">
          {{ block.settings.link_label | escape }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
    <div class="ai-product-listing__grid-{{ ai_gen_id }}">
      {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
        <article class="ai-product-listing__card-{{ ai_gen_id }}">
          <a class="ai-product-listing__card-link-{{ ai_gen_id }}" href="{{ product.url }}">
            <div class="ai-product-listing__image-wrap-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ai-product-listing__info-{{ ai_gen_id }}">
              <h3 class="ai-product-listing__product-title-{{ ai_gen_id }}">{{ product.title | escape }}</h3>
              <div class="ai-product-listing__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-product-listing__empty-{{ ai_gen_id }}">
      Select a collection to display products.
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product listing",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore our latest styles and essentials."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Product listing"
    }
  ],
  "tag": null,
  "class": "product-listing-block"
}
{% endschema %}