{% doc %}
  @prompt
    aik fashion product listing ka colume bana ky do, product ki jaga collecion select ka option do or 8 products ki listing ho in row or handing sub title link lable ky optionn bi do
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fashion-collection-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; color: {{ block.settings.text_color }}; }
  .ai-fashion-collection__header-{{ ai_gen_id }} { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .ai-fashion-collection__heading-{{ ai_gen_id }} { margin: 0; color: {{ block.settings.text_color }}; font-size: {{ block.settings.heading_size }}px; line-height: 1.15; }
  .ai-fashion-collection__subtitle-{{ ai_gen_id }} { margin: 8px 0 0; color: {{ block.settings.muted_color }}; font-size: 15px; line-height: 1.5; }
  .ai-fashion-collection__link-{{ ai_gen_id }} { flex-shrink: 0; color: {{ block.settings.link_color }}; font-size: 14px; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .ai-fashion-collection__grid-{{ ai_gen_id }} { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: {{ block.settings.grid_gap }}px; }
  .ai-fashion-collection__card-{{ ai_gen_id }} { min-width: 0; background: {{ block.settings.card_background }}; border: 1px solid {{ block.settings.border_color }}; border-radius: {{ block.settings.card_radius }}px; overflow: hidden; }
  .ai-fashion-collection__image-{{ ai_gen_id }} { display: block; aspect-ratio: 4 / 5; background: {{ block.settings.image_background }}; overflow: hidden; }
  .ai-fashion-collection__image-{{ ai_gen_id }} img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.2s ease; }
  .ai-fashion-collection__image-{{ ai_gen_id }}:hover img { transform: scale(1.03); }
  .ai-fashion-collection__placeholder-{{ ai_gen_id }} { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: {{ block.settings.muted_color }}; }
  .ai-fashion-collection__placeholder-{{ ai_gen_id }} svg { width: 60%; height: 60%; }
  .ai-fashion-collection__info-{{ ai_gen_id }} { padding: 14px; }
  .ai-fashion-collection__title-{{ ai_gen_id }} { margin: 0 0 8px; font-size: 15px; line-height: 1.35; }
  .ai-fashion-collection__title-{{ ai_gen_id }} a { color: {{ block.settings.text_color }}; text-decoration: none; }
  .ai-fashion-collection__title-{{ ai_gen_id }} a:hover, .ai-fashion-collection__title-{{ ai_gen_id }} a:focus-visible { text-decoration: underline; }
  .ai-fashion-collection__price-{{ ai_gen_id }} { color: {{ block.settings.text_color }}; font-size: 14px; font-weight: 700; }
  .ai-fashion-collection__empty-{{ ai_gen_id }} { padding: 28px; color: {{ block.settings.muted_color }}; background: {{ block.settings.card_background }}; border: 1px solid {{ block.settings.border_color }}; text-align: center; }
  @media screen and (max-width: 749px) { .ai-fashion-collection__header-{{ ai_gen_id }} { align-items: start; flex-direction: column; } .ai-fashion-collection__grid-{{ ai_gen_id }} { grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr)); gap: 12px; } .ai-fashion-collection__info-{{ ai_gen_id }} { padding: 10px; } .ai-fashion-collection__title-{{ ai_gen_id }} { font-size: 14px; } }
{% endstyle %}

<div class="ai-fashion-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-fashion-collection__header-{{ ai_gen_id }}">
    <div>
      {% if block.settings.heading != blank %}<h2 class="ai-fashion-collection__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.subtitle != blank %}<p class="ai-fashion-collection__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle | escape }}</p>{% endif %}
    </div>
    {% if block.settings.show_link and block.settings.collection != blank %}<a class="ai-fashion-collection__link-{{ ai_gen_id }}" href="{{ block.settings.link_url | default: block.settings.collection.url }}">{{ block.settings.link_label | escape }}</a>{% endif %}
  </div>

  {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
    <div class="ai-fashion-collection__grid-{{ ai_gen_id }}">
      {% for product in block.settings.collection.products limit: 8 %}
        <article class="ai-fashion-collection__card-{{ ai_gen_id }}">
          <a class="ai-fashion-collection__image-{{ ai_gen_id }}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy">{% else %}<div class="ai-fashion-collection__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
          </a>
          <div class="ai-fashion-collection__info-{{ ai_gen_id }}">
            <h3 class="ai-fashion-collection__title-{{ ai_gen_id }}"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            <div class="ai-fashion-collection__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}<div class="ai-fashion-collection__empty-{{ ai_gen_id }}">Collection select karein taake products yahan display hon.</div>{% endif %}
</div>

{% schema %}
{
  "name": "Fashion collection grid",
  "settings": [
    { "type": "header", "content": "Collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Explore our latest fashion styles." },
    { "type": "checkbox", "id": "show_link", "label": "Show collection link", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "mobile_columns", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 32, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 44, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#191919" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5f5f5f" },
    { "type": "color", "id": "link_color", "label": "Link", "default": "#1a1a1a" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#f5f5f5" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#e5e5e5" }
  ],
  "presets": [{ "name": "Fashion collection grid" }],
  "tag": null,
  "class": "fashion-collection-block"
}
{% endschema %}