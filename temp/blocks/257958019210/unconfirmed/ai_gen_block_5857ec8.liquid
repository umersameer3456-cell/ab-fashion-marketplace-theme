{% doc %}
  @prompt
    product buying page which it contain many small products pictures and its description in small or add to cart or buy buttons
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-buying-page-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-product-buying-page__heading-{{ ai_gen_id }} {
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.heading_alignment }};
    font-size: 28px;
    line-height: 1.2;
  }

  .ai-product-buying-page__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 18px;
  }

  .ai-product-buying-page__card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-product-buying-page__image-link-{{ ai_gen_id }} {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f4f4f4;
  }

  .ai-product-buying-page__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-buying-page__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: #f4f4f4;
  }

  .ai-product-buying-page__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    color: #777;
  }

  .ai-product-buying-page__content-{{ ai_gen_id }} {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
  }

  .ai-product-buying-page__title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.3;
  }

  .ai-product-buying-page__title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-buying-page__description-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.secondary_text_color }};
    font-size: 13px;
    line-height: 1.45;
  }

  .ai-product-buying-page__price-{{ ai_gen_id }} {
    margin-top: auto;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    font-weight: 700;
  }

  .ai-product-buying-page__actions-{{ ai_gen_id }} {
    display: grid;
    gap: 8px;
    margin-top: 2px;
  }

  .ai-product-buying-page__button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .ai-product-buying-page__button-{{ ai_gen_id }}--secondary {
    background: transparent;
    color: {{ block.settings.button_color }};
  }

  .ai-product-buying-page__button-{{ ai_gen_id }}:focus-visible,
  .ai-product-buying-page__title-{{ ai_gen_id }} a:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 2px;
  }

  .ai-product-buying-page__empty-{{ ai_gen_id }} {
    padding: 36px 20px;
    border: 1px dashed {{ block.settings.border_color }};
    color: {{ block.settings.secondary_text_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-product-buying-page__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 12px;
    }

    .ai-product-buying-page__content-{{ ai_gen_id }} {
      padding: 11px;
    }

    .ai-product-buying-page__heading-{{ ai_gen_id }} {
      font-size: 24px;
    }
  }
{% endstyle %}

<product-buying-page-{{ ai_gen_id }}
  class="ai-product-buying-page-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-product-buying-page__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if block.settings.products != blank %}
    <div class="ai-product-buying-page__grid-{{ ai_gen_id }}">
      {% for product in block.settings.products %}
        {% assign current_variant = product.selected_or_first_available_variant %}
        <article class="ai-product-buying-page__card-{{ ai_gen_id }}">
          <a class="ai-product-buying-page__image-link-{{ ai_gen_id }}" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
            {% if product.featured_image %}
              <img
                class="ai-product-buying-page__image-{{ ai_gen_id }}"
                src="{{ product.featured_image | image_url: width: 700 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="700"
                height="700"
              >
            {% else %}
              <div class="ai-product-buying-page__placeholder-{{ ai_gen_id }}">
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </a>
          <div class="ai-product-buying-page__content-{{ ai_gen_id }}">
            <h3 class="ai-product-buying-page__title-{{ ai_gen_id }}"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            {% if block.settings.show_description %}
              <p class="ai-product-buying-page__description-{{ ai_gen_id }}">{{ product.description | strip_html | truncate:  eighty }}</p>
            {% endif %}
            <div class="ai-product-buying-page__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
            <div class="ai-product-buying-page__actions-{{ ai_gen_id }}">
              {% if current_variant.available %}
                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  <button type="submit" name="add" class="ai-product-buying-page__button-{{ ai_gen_id }}">{{ block.settings.add_to_cart_label | escape }}</button>
                  {{ form | payment_button }}
                {% endform %}
              {% else %}
                <button type="button" class="ai-product-buying-page__button-{{ ai_gen_id }} ai-product-buying-page__button-{{ ai_gen_id }}--secondary" disabled>{{ block.settings.sold_out_label | escape }}</button>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-product-buying-page__empty-{{ ai_gen_id }}">Select products to display in this buying page.</div>
  {% endif %}
</product-buying-page-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Product buying page",
  "tag": null,
  "class": "product-buying-page-block",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop our products" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "checkbox", "id": "show_description", "label": "Show descriptions", "default": true },
    { "type": "text", "id": "add_to_cart_label", "label": "Add button", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Unavailable button", "default": "Sold out" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "radio", "id": "heading_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_background", "label": "Card", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#191919" },
    { "type": "color", "id": "secondary_text_color", "label": "Secondary text", "default": "#555555" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#dddddd" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#1a1a1a" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#35a93b" },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 4 }
  ],
  "presets": [{ "name": "Product buying page" }]
}
{% endschema %}